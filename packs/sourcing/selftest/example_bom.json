{
  "schema": "nopekit.bom/1",
  "_comment": "A complete, passing BOM for an invented product: a small sensor node in a machined enclosure. It is the worked example referenced by PACK.md, as a BOM in the file-based spelling (bom_path) rather than inline. The negative controls do NOT build on it - they are sealed to selftest/baseline.json, which is the projection CI asserts every gate passes. Every vendor and part number here is invented.",
  "product": "sensor node, enclosure + board assembly",
  "currency": "USD",
  "build_quantity": 250,
  "budget_per_unit": 52.0,
  "lead_time_budget_weeks": 16,
  "moq_ratio_limit": 3.0,
  "moq_excess_limit": 50.0,
  "moq_idle_limit_fraction": 0.10,
  "single_source_limit": 0,

  "design": {
    "surface_finish": "ENIG",
    "contact_type": "pressed",
    "material": "aluminium-6061",
    "region": "NA",
    "assembly_tier": "standard"
  },

  "process_rules": [
    {
      "id": "finish-for-pressed-contact",
      "scope": "design",
      "when": {"contact_type": "pressed"},
      "require": {"surface_finish": {"in": ["ENIG", "hard-gold"]}},
      "note": "the assembler states a pressed contact needs a flat plated pad; a levelled solder finish leaves a domed pad and the contact resistance walks with temperature"
    },
    {
      "id": "material-availability-in-region",
      "scope": "design",
      "require": {"material": {"not_in": ["titanium-gr5", "alloy-k9"]}},
      "note": "not stocked in this region at this quantity; an import buy adds ~14 weeks and a customs broker"
    },
    {
      "id": "assembly-tier",
      "scope": "design",
      "require": {"assembly_tier": {"in": ["standard", "fine-pitch"]}},
      "note": "anything below 0.4 mm pitch moves to a different line with its own quote, its own queue and a longer first-article"
    },
    {
      "id": "milling-tolerance-capability",
      "scope": "line",
      "when": {"process": "cnc-milling"},
      "require": {"tolerance_mm": {"min": 0.13}},
      "note": "the shop holds +/-0.13 mm on milled features as quoted; tighter is a secondary operation and a separate price"
    },
    {
      "id": "fab-tolerance-capability",
      "scope": "line",
      "when": {"process": "pcb-fab"},
      "require": {"tolerance_mm": {"min": 0.08}},
      "note": "standard-class fabrication; tighter registration moves the board to the advanced-class price list"
    }
  ],

  "order_minimums": {
    "Meridian Labelworks": 75.0,
    "Selkirk Polymer": 150.0
  },

  "charges": [
    {"id": "enclosure-fixture", "vendor": "Northgate Machining", "amount": 850.0, "description": "soft-jaw work holding, one time, kept by the shop"},
    {"id": "assembly-setup", "vendor": "Halberd Circuits", "amount": 320.0, "description": "stencil and line setup, charged per order"},
    {"id": "test-fixture", "vendor": "in-house", "amount": 1200.0, "description": "functional test fixture, one time"}
  ],

